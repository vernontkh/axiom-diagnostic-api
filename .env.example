# Google AI Studio key: https://aistudio.google.com/apikey
# Set this in Vercel under Settings → Environment Variables. Never commit it.
GEMINI_API_KEY=

# Optional. Overrides the default model without a redeploy of the code.
# Check https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_MODEL=gemini-3.5-flash
